
{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "# Azure Firewall Analytics\n---\nAllow / deny decisions from **network** and **application** rule collections.\n\nQueries use the **resource-specific** tables (`AZFWNetworkRule`, `AZFWApplicationRule`) populated when the firewall diagnostic setting uses the *Resource specific* destination type. Pick a workspace and time range below - every tile/grid on the page targets the selected workspace."
      },
      "name": "title"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "crossComponentResources": [
          "value::tenant"
        ],
        "parameters": [
          {
            "id": "workspace",
            "version": "KqlParameterItem/1.0",
            "name": "Workspace",
            "label": "Log Analytics workspace",
            "type": 5,
            "isRequired": true,
            "query": "resources\r\n| where type =~ 'microsoft.operationalinsights/workspaces'\r\n| where resourceGroup =~ 'rg-irazfw'\r\n| project id, name\r\n| order by name asc",
            "crossComponentResources": [
              "value::tenant"
            ],
            "typeSettings": {
              "resourceTypeFilter": {
                "microsoft.operationalinsights/workspaces": true
              },
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "queryType": 1,
            "resourceType": "microsoft.resources/tenants",
            "value": "/subscriptions/e315fe54-eae5-464d-8266-0f41a0908da8/resourceGroups/rg-irazfw/providers/Microsoft.OperationalInsights/workspaces/law-afw-irazfw-cac"
          },
          {
            "id": "timeRange",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "label": "Time range",
            "type": 4,
            "isRequired": true,
            "value": {
              "durationMs": 1800000
            },
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 1800000
                },
                {
                  "durationMs": 3600000
                },
                {
                  "durationMs": 14400000
                },
                {
                  "durationMs": 43200000
                },
                {
                  "durationMs": 86400000
                },
                {
                  "durationMs": 259200000
                },
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 2592000000
                }
              ]
            }
          }
        ],
        "style": "pills",
        "queryType": 1,
        "resourceType": "microsoft.resources/tenants"
      },
      "name": "parameters"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "union isfuzzy=true (AZFWNetworkRule | extend Kind='Network'), (AZFWApplicationRule | extend Kind='Application')\n| summarize Count=count() by Kind, Action\n| order by Kind asc, Action asc",
        "size": 4,
        "title": "Action summary (Network + Application)",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "tiles",
        "tileSettings": {
          "titleContent": {
            "columnMatch": "Kind"
          },
          "subtitleContent": {
            "columnMatch": "Action"
          },
          "leftContent": {
            "columnMatch": "Count",
            "formatter": 12,
            "formatOptions": {
              "palette": "auto"
            }
          },
          "showBorder": true
        }
      },
      "name": "action-tiles"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "union (AZFWNetworkRule | extend Kind='Network'), (AZFWApplicationRule | extend Kind='Application')\n| summarize Count=count() by bin(TimeGenerated, 15m), Action\n| render timechart",
        "size": 0,
        "title": "Allow vs Deny over time",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ]
      },
      "name": "action-timeseries"
    },
    {
      "type": 1,
      "content": {
        "json": "## Network rules"
      },
      "name": "network-section"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "AZFWNetworkRule\n| where Action == 'Deny'\n| summarize Denies=count() by SourceIp\n| top 20 by Denies desc",
        "size": 0,
        "title": "Top denied sources",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "barchart"
      },
      "customWidth": "50",
      "name": "net-deny-sources"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "AZFWNetworkRule\n| where Action == 'Deny'\n| summarize Denies=count() by DestinationIp, DestinationPort, Protocol\n| top 20 by Denies desc",
        "size": 0,
        "title": "Top denied destinations (ip:port/proto)",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ]
      },
      "customWidth": "50",
      "name": "net-deny-destinations"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "AZFWNetworkRule\n| where Action == 'Allow'\n| summarize Hits=count() by DestinationPort, Protocol\n| top 20 by Hits desc",
        "size": 0,
        "title": "Allowed traffic by destination port / protocol",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ]
      },
      "customWidth": "50",
      "name": "net-allow-ports"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "AZFWNetworkRule\n| summarize Hits=count(), Allows=countif(Action=='Allow'), Denies=countif(Action=='Deny') by Policy, RuleCollection, Rule\n| top 25 by Hits desc",
        "size": 0,
        "title": "Rule hits (Policy / Collection / Rule)",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Denies",
              "formatter": 8,
              "formatOptions": {
                "palette": "red"
              }
            },
            {
              "columnMatch": "Allows",
              "formatter": 8,
              "formatOptions": {
                "palette": "green"
              }
            },
            {
              "columnMatch": "Hits",
              "formatter": 8,
              "formatOptions": {
                "palette": "blue"
              }
            }
          ]
        }
      },
      "customWidth": "50",
      "name": "net-rule-hits"
    },
    {
      "type": 1,
      "content": {
        "json": "## Application rules (L7 / FQDN)"
      },
      "name": "app-section"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "AZFWApplicationRule\n| summarize Hits=count() by Fqdn, Action\n| top 25 by Hits desc",
        "size": 0,
        "title": "Top FQDNs",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ]
      },
      "customWidth": "50",
      "name": "app-fqdns"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "AZFWApplicationRule\n| where Action == 'Deny'\n| summarize Denies=count() by SourceIp, Fqdn\n| top 25 by Denies desc",
        "size": 0,
        "title": "Denied FQDN requests by source",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ]
      },
      "customWidth": "50",
      "name": "app-denies"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "AZFWApplicationRule\n| where isnotempty(WebCategory)\n| summarize Hits=count() by WebCategory, Action\n| top 25 by Hits desc",
        "size": 0,
        "title": "Web categories",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ]
      },
      "customWidth": "50",
      "name": "app-web-categories"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "AZFWApplicationRule\n| summarize Hits=count(), Allows=countif(Action=='Allow'), Denies=countif(Action=='Deny') by Policy, RuleCollection, Rule\n| top 25 by Hits desc",
        "size": 0,
        "title": "Application rule hits",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Denies",
              "formatter": 8,
              "formatOptions": {
                "palette": "red"
              }
            },
            {
              "columnMatch": "Allows",
              "formatter": 8,
              "formatOptions": {
                "palette": "green"
              }
            },
            {
              "columnMatch": "Hits",
              "formatter": 8,
              "formatOptions": {
                "palette": "blue"
              }
            }
          ]
        }
      },
      "customWidth": "50",
      "name": "app-rule-hits"
    },
    {
      "type": 1,
      "content": {
        "json": "## Recent events"
      },
      "name": "raw-section"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "union (AZFWNetworkRule | extend Kind='Network', Target=strcat(DestinationIp, ':', tostring(DestinationPort))),\n      (AZFWApplicationRule | extend Kind='Application', Target=Fqdn)\n| project TimeGenerated, Kind, Action, SourceIp, Target, Protocol, Policy, RuleCollection, Rule\n| order by TimeGenerated desc\n| take 200",
        "size": 0,
        "title": "Recent events (200)",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Action",
              "formatter": 11
            }
          ]
        }
      },
      "name": "recent-raw"
    }
  ],
  "fallbackResourceIds": [
    "Azure Monitor"
  ],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}